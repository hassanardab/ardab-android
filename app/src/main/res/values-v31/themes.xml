<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Use AppCompat as the parent so AppCompatActivity doesn't crash -->
    <style name="Theme.Ardab" parent="Theme.AppCompat.DayNight.NoActionBar">

        <!-- Native Android 12+ (API 31+) Splash Screen attributes -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/logo_vector</item>
        <item name="android:windowSplashScreenBackground">#ffffff</item>

        <!-- AndroidX Core SplashScreen library attributes (for older Android versions) -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo_vector</item>
        <item name="windowSplashScreenBackground">#ffffff</item>

    </style>
</resources>